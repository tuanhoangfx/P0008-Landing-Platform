{
  "schemaVersion": 1,
  "code": "P0008",
  "id": "landing-platform",
  "aliases": [
    "P0008",
    "Landing Platform",
    "LDP"
  ],
  "name": "Landing Platform",
  "type": "Web",
  "owner": "Tool",
  "status": "Active",
  "summary": "One static-site engine for every product landing + step-by-step guide (sites/<id>/). ldp.infi.io.vn is the Hub-UI admin of the library: Templates · Sections · Sites · System (read-only, catalog.json built from the files).",
  "stack": [
    "Vite",
    "React",
    "Hub-UI",
    "GSAP",
    "Lenis",
    "Node"
  ],
  "deployTarget": "lenovo-static",
  "github": {
    "repo": "tuanhoangfx/P0008-Landing-Platform",
    "branch": "main",
    "manifestPath": "tool.manifest.json"
  },
  "urls": {
    "local": "http://127.0.0.1:3008",
    "app": "https://ldp.infi.io.vn",
    "prodProbe": "https://ldp.infi.io.vn/"
  },
  "health": {
    "status": "Active",
    "note": "ldp.infi.io.vn = Hub-UI admin (public read-only catalog, ?screen= routes) + /preview/ section renders; sites deploy under their own <CODE>-SITE keys."
  },
  "docs": {
    "readme": "README.md",
    "changelog": "CHANGELOG.md",
    "agents": "AGENTS.md",
    "ssot": "docs/LANDING-PLATFORM-SSOT.md"
  },
  "release": {
    "version": "2.1.0",
    "readiness": [
      "build",
      "audit-sites",
      "gate"
    ]
  },
  "ship": {
    "schemaVersion": 1,
    "fastPath": "Push",
    "releasePath": "Release",
    "deployTarget": "lenovo-static",
    "playbook": "Tool/docs/playbooks/release-fast-path.md",
    "script": "powershell -File E:DevToolscriptsship-product.ps1",
    "preShip": [
      "build-if-dist-stale"
    ]
  },
  "sites": {
    "engine": "engine/",
    "templates": [
      "product-guide"
    ],
    "registry": "sites/<id>/site.config.json",
    "gate": "node Tool/P0008-Landing-Platform/scripts/audit-sites.mjs"
  },
  "versions": {
    "current": "2.1.0"
  },
  "manifestUpdatedAt": "2026-10-24T02:11:41.920Z",
  "commands": {
    "dev": "pnpm dev",
    "build": "pnpm build:home",
    "typecheck": "pnpm typecheck"
  },
  "uiShell": {
    "golden": "P0020",
    "userFooter": "workspace",
    "splitScreens": [
      "templates",
      "sections",
      "sites"
    ]
  },
  "uiScreens": [
    {
      "screen": "templates",
      "label": "Templates",
      "route": "/?screen=templates",
      "template": "directory",
      "layout": "split-workspace",
      "golden": "P0024/places",
      "notes": "Directory + rail: page → section chain of the selected template."
    },
    {
      "screen": "sections",
      "label": "Sections",
      "route": "/?screen=sections",
      "template": "directory",
      "layout": "split-workspace",
      "golden": "P0024/places",
      "notes": "Directory grouped by group + rail with the live engine preview iframe (/preview/…)."
    },
    {
      "screen": "sites",
      "label": "Sites",
      "route": "/?screen=sites",
      "template": "directory",
      "layout": "split-workspace",
      "golden": "P0024/places",
      "notes": "Directory of sites/<id> + rail with og image and language URLs."
    },
    {
      "screen": "system",
      "label": "System",
      "route": "/?screen=system",
      "template": "system-params",
      "golden": "P0002/system",
      "notes": "HubSystemParamsScreen + Platform section + empty Design Template."
    }
  ],
  "auth": {
    "tier": "exempt",
    "note": "Public read-only catalog (same tier as P0022/P0024 in hub-login-auth card). No data plane, no writes."
  }
