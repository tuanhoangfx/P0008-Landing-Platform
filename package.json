{
  "name": "p0008-landing-platform",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "description": "P0008 Landing Platform — one static-site engine for every product landing + guide (sites/<id>/), plus the Hub-UI admin at ldp.infi.io.vn.",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js",
    "predev": "node engine/catalog.mjs",
    "dev:site": "node engine/dev-site.mjs --site videolab",
    "build": "node scripts/build-all.mjs",
    "build:home": "node scripts/build-home.mjs",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "node scripts/audit-sites.mjs",
    "new-site": "node scripts/new-site.mjs",
    "audit": "node scripts/audit-sites.mjs",
    "ship:lenovo": "node ../scripts/deploy-lenovo-static.mjs --code P0008"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.6",
    "@fontsource/be-vietnam-pro": "5.2.6",
    "@tool-workspace/hub-identity": "file:../../packages/hub-identity",
    "@tool-workspace/hub-ui": "file:../../packages/hub-ui",
    "gsap": "3.13.0",
    "lenis": "1.3.4",
    "lucide-react": "^0.561.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "tailwindcss": "3.4.13",
    "typescript": "^5.9.3",
    "vite": "7.3.6"
  }
}
